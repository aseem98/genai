# Copy this file to `.env` (same folder) and fill in your real key.
# `.env` is loaded automatically by 04_unified_llm_client.py for every module
# in this curriculum — no shell exports needed, and nothing here is committed.

# --- OmniRoute (or any OpenAI-compatible gateway/LLM) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=http://localhost:20128/v1

# Must match the combo/model name exactly as shown in your gateway dashboard,
# e.g. the "Free LLM" combo -> model: "Free LLM" (or "combo/Free LLM").
LLM_MODEL=Free LLM

# --- Optional: real Redis instead of module 27's in-memory simulation ---
# REDIS_URL=redis://localhost:6379/0
